<odoo>
    <record id="l10n_ve_contact_res_company_form" model="ir.ui.view">
        <field name="name">l10n.ve.contact.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="require_full_address"/>
            </xpath>
        </field>
    </record>
</odoo>
