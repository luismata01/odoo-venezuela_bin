
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[@class='pos-centerheader d-none d-xl-flex justify-content-center overflow-hidden']" position="replace">
            <div t-if="!ui.isSmall" class="pos-centerheader d-none d-xl-flex justify-content-center align-items-center overflow-hidden gap-3">
                <img style="max-height: 44px;" src="/l10n_ve_pos/static/src/img/teletrabajove.png" alt="TeletrabajoVE Logo" />
            </div>
        </xpath>
    </t>
</templates>
