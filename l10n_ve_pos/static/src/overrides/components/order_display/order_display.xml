<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.OrderDisplay" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <!-- Añadir info extranjera en el order-summary (se ve en ProductScreen y TicketScreen) -->
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <div t-if="order.config?.foreign_rate" class="foreign-summary d-flex flex-column gap-1 mt-1 border-top pt-1" style="font-size: 0.8rem;">
                <div class="d-flex justify-content-between w-100 text-muted">
                    <span>Tasa BCV</span>
                    <span t-esc="order.config.foreign_rate"/>
                </div>
                <div class="d-flex justify-content-between w-100 text-muted">
                    <span>Productos</span>
                    <span t-esc="order.get_qty_products()"/>
                </div>
                <div t-if="order.get_foreign_total_tax()" class="d-flex justify-content-between w-100 text-muted">
                    <span>Taxes (USD)</span>
                    <span t-out="env.utils.formatForeignCurrency(order.get_foreign_total_tax())"/>
                </div>
                <div class="d-flex justify-content-between w-100 fw-bolder">
                    <span>Total (USD)</span>
                    <span t-out="env.utils.formatForeignCurrency(order.get_foreign_total_with_tax())"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
