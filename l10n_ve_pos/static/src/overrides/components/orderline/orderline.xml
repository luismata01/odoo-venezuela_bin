<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-price')]" position="after">
            <t t-if="lineForeignPrice">
                <span class="text-muted"> / </span>
                <t t-out="lineForeignPrice"/>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('product-name')]" position="inside">
            <t t-if="lineAliquotType">
                <t t-out="lineAliquotType"/>
            </t>
            <t t-if="this.env.debug and lineForeignRateDisplay">
                (Tasa: <t t-out="lineForeignRateDisplay"/>)
            </t>
        </xpath>
    </t>
</templates>
