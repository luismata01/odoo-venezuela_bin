<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-amount')]" position="replace">
            <div class="payment-amount px-3">
                <t t-if="line.payment_method_id and line.payment_method_id.is_foreign_currency">
                    <t t-out="env.utils.formatForeignCurrency(line.get_foreign_amount ? line.get_foreign_amount() : 0)"/>
                </t>
                <t t-else="">
                    <t t-out="env.utils.formatCurrency(line.getAmount())"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
