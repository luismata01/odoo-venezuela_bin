<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='toggleIsToInvoice']" position="replace">
            <button 
                class="button js_invoice btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg"
                t-att-class="{ 'highlight active': currentOrder?.isToInvoice?.() ?? false, 'opacity-50': !pos.config.canInvoice }"
                t-on-click="toggleIsToInvoice"
                t-att-disabled="currentOrder?.lines[0]?.refunded_orderline_id?.order_id?.isToInvoice?.()">
                    <span>
                        <i class="fa fa-file-text-o me-2" />
                        <t t-if="pos.config.canInvoice">Invoice</t>
                        <t t-else="">Not available</t>
                    </span>
                    <i class="fa me-2" t-attf-class="{{ (currentOrder?.isToInvoice?.() ?? false) ? 'fa-check-square text-action' : 'fa-square-o' }}" />
            </button>
        </xpath>
    </t>
</templates>
