<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-amount')]" position="after">
            <div class="payment-status-foreign d-flex justify-content-between mt-2 fs-4 text-success">
                <span class="label pe-2">Foreign Total</span>
                <span t-out="foreignTotalDueText"/>
            </div>
        </xpath>
    </t>
</templates>