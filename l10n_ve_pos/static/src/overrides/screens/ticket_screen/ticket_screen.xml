<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <!-- Añadir FullRefundButton en el panel de control de órdenes sincronizadas -->
        <xpath expr="//div[hasclass('control-buttons')]/button[last()]" position="after">
            <FullRefundButton order="_selectedSyncedOrder" ticket_screen="this"/>
        </xpath>
    </t>
</templates>
