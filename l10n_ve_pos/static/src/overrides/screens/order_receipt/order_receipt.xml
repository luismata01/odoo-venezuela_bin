<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-total')]" position="after">
            <div class="pos-receipt-amount receipt-foreign-total fw-bolder">
                <span class="label-total">Total (Foreign)</span>
                <span t-out="env.utils.formatForeignCurrency(props.order.get_foreign_total_with_tax())" class="pos-receipt-right-align font-monospace"/>
            </div>
        </xpath>
    </t>
</templates>